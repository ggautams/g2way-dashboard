{
  "name": "g2way-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "check:bundle": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-client-bundle.mjs",
    "check:g2way": "node scripts/check-g2way.mjs",
    "sync:g2way": "node scripts/sync-g2way.mjs",
    "db:generate": "node scripts/db-generate.mjs",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.mts",
    "ui:add": "node scripts/shadcn-tokens.mjs --add"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.47.0",
    "monaco-editor": "^0.56.0",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "openapi-fetch": "^0.17.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}

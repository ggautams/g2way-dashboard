# g2way-dashboard configuration. Copy to .env.local and fill in.
# Every variable here is read server-side only. The admin secret controls the
# whole gateway; it is never sent to the browser.

# ---- Single gateway (the common case) --------------------------------------
# Names match g2way's own, so one .env can drive both processes.

# Admin API base URL — where the gateway's G2_ADMIN_LISTEN is reachable.
# Default: http://127.0.0.1:9696
G2_ADMIN_URL=http://127.0.0.1:9696

# The gateway's admin secret, sent as X-G2-Authorization. Required.
G2_ADMIN_SECRET=

# Proxy (data-plane) base URL — where the gateway's G2_LISTEN is reachable from
# this server. Used only by the API designer's request console, which sends
# test requests through the gateway to real upstreams (ADR-0011); the admin
# secret is never sent there. No default: unset, the console says it is not
# configured. Optional.
# G2_PROXY_URL=http://127.0.0.1:8080

# The gateway's Redis — the same URL as g2way's own G2_REDIS_URL. Only the
# analytics ingest worker uses it, to drain g2:{org}:analytics:records (ADR-0012);
# the gateway must run with --analytics-sink redis (G2_ANALYTICS_SINK=redis).
# Never written to. Unset, this gateway has no traffic analytics. May carry a
# password: server-only, never echoed. redis:// or rediss://. Optional.
# G2_REDIS_URL=redis://127.0.0.1:6379

# ---- Several named gateways (optional) -------------------------------------
# Setting G2_ENVIRONMENTS switches to this form and ignores G2_ADMIN_URL /
# G2_ADMIN_SECRET. Ids use a-z, 0-9 and -; each id's variables are prefixed
# G2_ENV_<ID>_ with the id upper-cased and - turned into _.

# G2_ENVIRONMENTS=dev,staging-eu
# G2_ENV_DEV_URL=http://127.0.0.1:9696
# G2_ENV_DEV_SECRET=
# G2_ENV_DEV_LABEL=Local dev              # optional; defaults to the id
# G2_ENV_DEV_PROXY_URL=http://127.0.0.1:8080   # optional; the request console
# G2_ENV_DEV_REDIS_URL=redis://127.0.0.1:6379   # optional; analytics ingest
# G2_ENV_STAGING_EU_URL=https://gw-admin.staging.example.com
# G2_ENV_STAGING_EU_SECRET=

# Environment selected by default. Default: the first one listed.
# G2_DEFAULT_ENVIRONMENT=dev

# ---- Tenancy ----------------------------------------------------------------
# Org id carried on every gateway request and dashboard record (ADR-0007). The
# BFF sets it as ?org_id= where the gateway takes one, adds it to API, policy
# and key write bodies that name none, and refuses a body naming another org.
# Every dashboard row and session is scoped to it: changing it signs everyone
# out and shows a fresh, empty org (first-run setup again). g2way only supports
# its default org today. Default: default
# G2_ORG_ID=default

# ---- Analytics ingest (ADR-0012) -------------------------------------------
# The worker drains every environment that names a Redis URL into rollup tables
# in the dashboard database. It runs inside the server unless turned off here;
# then run it as its own process with `make ingest` (npm run ingest).
# G2_ANALYTICS_INGEST=on                   # on | off. Default: on
# Records popped per drain; also the most a hard crash can lose. 1-10000.
# G2_ANALYTICS_BATCH=1000
# Retention: minute rollups (1-90 days) and hour rollups (1-3650 days).
# G2_ANALYTICS_MINUTE_RETENTION_DAYS=3
# G2_ANALYTICS_HOUR_RETENTION_DAYS=90
# Live request inspector (ADR-0014): the newest requests kept per environment,
# for 15 minutes, without client IP or User-Agent. 0 keeps none. 0-1000.
# Set it on whichever process runs the worker.
# G2_ANALYTICS_TAIL_ROWS=200

# ---- Dashboard database -----------------------------------------------------
# Where the dashboard keeps its own state (users, audit log, history). Never the
# gateway's Redis. Migrations run automatically on server start, or with
# `make db-migrate`.
#   unset                         SQLite at ./data/dashboard.db (created on first run)
#   file:./path/to/dashboard.db   SQLite at that path
#   postgres://user:pass@host:5432/dbname   (or postgresql://) Postgres
# DATABASE_URL=file:./data/dashboard.db

# ---- Dashboard sign-in (Auth.js) ---------------------------------------------
# Accounts live in the dashboard database; the first one is created at /setup on
# first run and becomes the owner.

# Encrypts and signs session cookies. Required in production; changing it signs
# everyone out. Generate one with:  openssl rand -base64 32   (or npx auth secret)
AUTH_SECRET=

# The dashboard's public URL, when Auth.js cannot infer it — e.g. behind a
# reverse proxy that rewrites the host. Optional. The BFF's cross-site check
# also always accepts writes whose Origin is this URL's origin.
# AUTH_URL=https://dashboard.example.com

# Trust the Host / X-Forwarded-Host headers to build the dashboard's own URL.
# Needed for `next start` in production unless AUTH_URL is set. Only enable it
# when the dashboard is reached directly or through a proxy you control.
# The BFF's cross-site write check uses the same switch: it compares a write's
# Origin with the Host header the browser sent, and only when this is `true`
# (or `1`) with the proxy's X-Forwarded-Host / X-Forwarded-Proto instead. Set it
# only behind a proxy that overwrites those headers; directly exposed, leave it
# unset and the Host header is used. (Auth.js itself treats any non-empty value,
# and every non-production run, as trusted; the BFF honours only true/1.)
# AUTH_TRUST_HOST=true
